# ====== BẮT BUỘC ======
DATABASE_URL=postgresql://user:pass@host:5432/db
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon>
SUPABASE_SERVICE_ROLE_KEY=<service-role>
MS_CLIENT_ID=<azure app client id>
MS_CLIENT_SECRET=<azure app client secret>
MS_TENANT_ID=<azure tenant id>
MS_TARGET_MAILBOX=drilling@psbvn.com
WEBHOOK_BASE_URL=https://<public-host>   # Microsoft tới được; ngrok tunnels OK
GEMINI_API_KEY=<google ai studio>

# ====== KHÔNG BẮT BUỘC (mặc định hoạt động với giá trị mặc định) ======
# Khung giờ Agent hoạt động (HH:MM, timezone Asia/Ho_Chi_Minh). Ngoài khung → tạm dừng,
# gom email tồn đọng lúc kích hoạt. Để START > END cho khung qua đêm (vd 22:00→06:00).
AGENT_TIMEZONE=Asia/Ho_Chi_Minh
AGENT_ACTIVE_START=08:00
AGENT_ACTIVE_END=18:00
AGENT_ACTIVE_DAYS=mon,tue,wed,thu,fri,sat,sun

INGESTION_ENABLED=true
INGESTION_POLL_INTERVAL_SECONDS=60
INGESTION_CATCHUP_DAYS=7
INGESTION_BATCH_SIZE=25

WEBAPP_BASE_URL=http://localhost:3000  # webapp PSBV (SPEC G2 + P8 Email Gateway BFF)
SERVICE_ROLE_SECRET=<service-role-secret cho Bearer Bearer @ webapp /api/email-gateway>
